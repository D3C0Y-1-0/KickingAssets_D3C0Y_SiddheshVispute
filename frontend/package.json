{
  "name": "gridsentinel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "cytoscape": "^3.33.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
